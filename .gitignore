.env
.coder-notes.md
.claude/worktrees/

# Visual regression (Playwright) — ajouté v2.32.1
node_modules/
# Sans slash : `node_modules/` ne couvre QUE le repertoire. Un worktree qui
# pointe vers les dependances du checkout principal cree un SYMLINK du meme
# nom, que `git add -A` ajoutait alors au depot.
node_modules
visual-tests/diffs/
test-results/
playwright-report/

# Build artifacts locaux (shared/build.sh) — ajouté avant deploy v2.48.0
# Exception (#657, I1a) : le DS n'a aucun build au deploiement (Caddy sert le statique
# tel quel) -> l'artefact esbuild du moteur graph est GENERE mais COMMITE (meme logique
# que shared/icons/sprite.svg). Regenerer via shared/graph/build.sh apres toute modif
# de shared/graph/lib/*.js.
# Fix #762 : `!shared/dist/` reincluait le dossier entier et annulait l'ignore -> il
# faut exclure le CONTENU (`shared/dist/*`) puis lister les exceptions fichier par fichier.
shared/dist/*
!shared/dist/graph-lib.global.js
!shared/dist/graph.global.js

# @msyx-dev/react — build artifact généré (ne pas commiter)
packages/react/dist/
packages/react/node_modules/
pnpm-lock.yaml
# Exception : lockfile packages/react commité pour CI --frozen-lockfile (#307)
!packages/react/pnpm-lock.yaml
test-results-a11y/
playwright-report-a11y/

# Lighthouse CI run artifacts (rapports locaux — baseline versionnee dans lhci-baseline.json)
.lighthouseci/

# Page d'accès orpheline vestige pré-static-proxy (jamais versionnée)
auth-static/
